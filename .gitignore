# =========================================================================
# Git Ignore patterns for Visual Studio and VS Code (C++ OpenGL Project)
# =========================================================================

# -------------------------------------------------------------------------
# compiler/linker outputs (ผลลัพธ์จากการคอมไพล์)
# -------------------------------------------------------------------------
*.exe
*.o
*.obj
*.pdb
*.ilk
*.idb
*.gch
*.d
*.out

# -------------------------------------------------------------------------
# Visual Studio Temporary and Build Files (ไฟล์ชั่วคราวของ VS)
# -------------------------------------------------------------------------
.vs/
Debug/
Release/
x64/
x86/
build/
out/
ARM/
ARM64/

# Visual Studio project-specific temporary files
*.suo
*.user
*.userosscache
*.sln.docstates
*.ncb
*.sdf
*.opensdf
*.dbmdl
*.lsproj.user
*.sqlproj.user
*.vcxproj.user
*.ipch/
ipch/

# Backup files
_UpgradeReport_Files/
Backup*/

# -------------------------------------------------------------------------
# VS Code files (ไฟล์และการตั้งค่าชั่วคราวของ VS Code)
# -------------------------------------------------------------------------
.vscode/ipch/
.history/
*.log

# Keep VS Code tasks/launch configurations if you want to share them
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/c_cpp_properties.json

# -------------------------------------------------------------------------
# OS generated files (ไฟล์จากระบบปฏิบัติการ)
# -------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
